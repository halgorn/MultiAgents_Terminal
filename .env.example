ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-m3
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-Text-01
AI_RUNTIME_CODEX_MODEL=gpt-5-codex
AI_RUNTIME_DB_PATH=   # optional override, default: ~/.ai-runtime/tasks.db
AION_CODEX_IGNORE_RULES=   # optional, set to 1 to pass --ignore-rules to Codex CLI
AION_SKIP_UPDATE_CHECK=    # optional, set to 1 for tests/offline CI

# Optional embedding providers for memory/eval. Leave empty to use local hash embeddings.
VOYAGE_API_KEY=
OPENAI_API_KEY=
QDRANT_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: set to "langgraph" to run analyze/fix/review through LangGraph adapter.
AION_ORCHESTRATOR=

# Optional read-only cloud detection.
AWS_ACCESS_KEY_ID=
AWS_PROFILE=
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Standard OS environment variables read for cache paths.
HOME=
USERPROFILE=
