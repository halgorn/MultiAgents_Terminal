{
  "name": "@walo/aion",
  "version": "0.2.0",
  "description": "Multi-agent AI engineering runtime — audit, fix, graph, analyze",
  "type": "module",
  "bin": {
    "aion": "./dist/index.js",
    "ai-runtime": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:unit": "npm run test",
    "test:scale": "npm run build && node --test \"dist/core/pipelines/audit-pipeline.test.js\"",
    "smoke:manus": "npm run dev -- --cwd /home/bruno/Documents/GitHub/Manus_Private audit . -n 1",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "install-global": "npm run build && npm link",
    "uninstall-global": "npm unlink -g @walo/aion"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai", "audit", "multi-agent", "code-analysis", "security", "cli"
  ],
  "author": "Bruno Inácio <contact@walo.us>",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "dotenv": "^16.4.5",
    "ora": "^8.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  }
}
