{
  "name": "@aionlabsai/aion",
  "version": "0.3.21",
  "description": "Multi-agent AI engineering runtime — audit, fix, graph, analyze",
  "type": "module",
  "bin": {
    "aion": "dist/index.js",
    "ai-runtime": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:unit": "npm run test",
    "test:scale": "npm run build && node --import tsx --test \"src/core/pipelines/audit-pipeline.test.ts\"",
    "smoke:manus": "npm run dev -- --cwd /home/bruno/Documents/GitHub/Manus_Private audit . -n 1",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "install-global": "npm run build && npm link",
    "uninstall-global": "npm unlink -g @aionlabsai/aion"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "audit",
    "multi-agent",
    "code-analysis",
    "security",
    "cli"
  ],
  "author": "Bruno Inácio <contact@walo.us>",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@langchain/langgraph": "^1.3.6",
    "@langfuse/client": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xenova/transformers": "^2.17.2",
    "chalk": "5.6.2",
    "commander": "13.1.0",
    "dotenv": "16.6.1",
    "langfuse": "^3.38.20",
    "ora": "8.2.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-typescript": "0.23.2",
    "ts-morph": "28.0.0",
    "web-tree-sitter": "0.26.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
