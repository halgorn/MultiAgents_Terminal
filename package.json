{
  "name": "@aionlabsai/aion",
  "version": "1.0.1-alpha",
  "description": "The project gateway for code-aware AI agents — cuts tokens, kills hallucinations, sits between your IDE and your codebase.",
  "type": "module",
  "bin": {
    "aion": "dist/index.js",
    "ai-runtime": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,md,json,yml,yaml}\" \"*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,md,json,yml,yaml}\" \"*.{md,json,yml,yaml}\"",
    "test": "npm run build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:unit": "npm run test",
    "test:contract": "node --import tsx --test src/schemas/contracts.test.ts src/schemas/registry.test.ts",
    "test:integration": "node --import tsx --test \"src/__integration__/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm run test:unit",
    "test:scale": "npm run build && node --import tsx --test \"src/core/pipelines/audit-pipeline.test.ts\"",
    "test:ci": "npm run typecheck && npm run lint && npm run test:contract && npm run test:unit && npm run test:integration",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "release-check": "npm run build && node dist/index.js release-check --skip-build",
    "prepublishOnly": "npm run build",
    "install-global": "npm run build && npm link",
    "uninstall-global": "npm unlink -g @aionlabsai/aion",
    "postinstall": "node -e \"const pkg=require('./package.json');if(pkg.name!=='@aionlabsai/aion')process.exit(0);process.exit(0)\"",
    "check:layers": "node scripts/check-layers.mjs",
    "check:doc-drift": "node scripts/check-doc-drift.mjs"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/test-utils/**",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "mcp",
    "rag",
    "model-context-protocol",
    "code-intelligence",
    "agent-gateway",
    "llm-gateway",
    "cursor",
    "claude-code",
    "codex"
  ],
  "author": "Bruno Inácio <contact@aion.dev>",
  "license": "MIT",
  "homepage": "https://aion.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/aionlabs/aion.git"
  },
  "bugs": {
    "url": "https://github.com/aionlabs/aion/issues",
    "email": "security@aion.dev"
  },
  "dependencies": {
    "@aionlabsai/aion": "^1.0.0-alpha",
    "@anthropic-ai/sdk": "0.100.1",
    "@langchain/langgraph": "^1.3.6",
    "@langfuse/client": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xenova/transformers": "^2.17.2",
    "chalk": "5.6.2",
    "commander": "13.1.0",
    "dotenv": "16.6.1",
    "langfuse": "^3.38.20",
    "ora": "8.2.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-typescript": "0.23.2",
    "ts-morph": "28.0.0",
    "web-tree-sitter": "0.26.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "c8": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
